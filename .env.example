# Security
MCP_INDIA_STACK_API_KEY="your-secret-key-here"
MCP_INDIA_STACK_ALLOWED_ORIGINS="http://localhost:3000,https://your-frontend.com"
MCP_INDIA_STACK_RATE_LIMIT="120/60"

# Telemetry
MCP_INDIA_STACK_TELEMETRY_PEPPER="your-secret-pepper"
MCP_INDIA_STACK_LOG_PATH="./telemetry.jsonl"

# Feature Flags
MCP_INDIA_STACK_ENABLE_ELEVATED_TOOLS=0
MCP_INDIA_STACK_NO_AUTO_UPDATE=0
MCP_INDIA_STACK_BULK_WORKERS=5
